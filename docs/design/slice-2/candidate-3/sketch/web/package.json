{
  "name": "saasx2x-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "uv run python -m saasx2x.web > openapi.json && openapi-typescript openapi.json -o src/api.gen.ts",
    "gen:check": "npm run gen && git diff --exit-code -- openapi.json src/api.gen.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.5.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
